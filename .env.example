# Official Binance Agentic MCP endpoint
BINANCE_MCP_URL=https://agent.binance.com/mcp/agentic
# Authorization value expected by the connected Agentic sub-account, e.g. Bearer ...
BINANCE_MCP_AUTH=
# Optional JSON headers supplied by Binance's connection flow
BINANCE_MCP_HEADERS_JSON={}
# Exact MCP tool and arguments used to collect the pre-decision market observation
BINANCE_MARKET_TOOL=
BINANCE_MARKET_ARGS_JSON={"symbol":"BTCUSDT"}
# Exact MCP tool used to place an order. Execution remains disabled unless explicitly enabled.
BINANCE_TRADE_TOOL=
BLACKBOX_TRADING_ENABLED=false
BLACKBOX_MAX_NOTIONAL_USDT=5
# OpenAI-compatible model endpoint. Server-side only.
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=
