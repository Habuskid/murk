# Celo Network Configuration
# Testnet-first development. Mainnet must be selected explicitly.
NEXT_PUBLIC_MURK_NETWORK=testnet
CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
#
# Mainnet override, only after Sepolia E2E passes:
# NEXT_PUBLIC_MURK_NETWORK=mainnet
# CELO_RPC_URL=https://forno.celo.org
# NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org

# ERC-8021 Celo attribution code assigned to Murk by the hackathon/program.
# Do not substitute a hostname-derived code for an assigned program code.
CELO_ATTRIBUTION_CODE=

# Neon Postgres Connection (Server-only)
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/murk?sslmode=require

# Privy authentication + embedded human wallet
# NEXT_PUBLIC_PRIVY_APP_ID is safe for the browser.
# PRIVY_APP_SECRET is server-only and must never use NEXT_PUBLIC_.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Server Agent Wallet (Protected Server-Only Secret)
# 32 random bytes encoded as hex. Murk derives one isolated EOA per immutable agent ID.
# Generate with: openssl rand -hex 32
AGENT_WALLET_MASTER_SECRET=

# x402 Protocol & Facilitator
# Testnet default: https://api.x402.sepolia.celo.org
# Mainnet later: https://api.x402.celo.org
X402_FACILITATOR_URL=https://api.x402.sepolia.celo.org

# Reference Rate Providers
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD


# Live external x402 resources used by the runtime UI.
# These must point to independent merchants. Do not point them at Murk's own API.
NEXT_PUBLIC_X402_RESOURCE_URL=
NEXT_PUBLIC_X402_BLOCKED_RESOURCE_URL=

# Local self-merchant is only a development fixture and must never be used as golden-demo evidence.
ENABLE_LOCAL_X402_FIXTURE=false

# Independent external x402 resource used by the live spike gate.
# Must return a real HTTP 402 on Celo. Never point this at Murk itself.
X402_PROBE_RESOURCE_URL=


# Manual evidence from the real browser-based Privy wallet flow.
# Populate only after completing and verifying the live flow.
USER_WALLET_VERIFIED_ADDRESS=
USER_WALLET_EVIDENCE_REFERENCE=


# Public deployed Murk origin used for ERC-8004 agent metadata.
# Use the staging deployment origin on Sepolia and the production origin on mainnet.
# Example: https://murk.example.com
# Registration refuses to prepare without this value.
PUBLIC_APP_ORIGIN=


# Celo Sepolia paid x402 engineering harness
# Keep disabled outside explicit testnet verification.
ENABLE_TESTNET_X402_MERCHANT=false

# Server-only API key from the Celo x402 facilitator dashboard.
X402_API_KEY=

# Testnet recipient for the engineering merchant.
# Must be a Celo Sepolia address you control.
TESTNET_X402_SELLER_ADDRESS=
