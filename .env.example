# Celo Network Configuration
CELO_RPC_URL=https://forno.celo.org
CELO_CHAIN_ID=42220

# Neon Postgres Connection (Server-only)
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/murk?sslmode=require

# Coinbase Developer Platform (CDP) for Embedded / Server Wallets
CDP_PROJECT_ID=
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=

# Server Agent Wallet Fallback (Protected Server-Only Secret)
# Used if CDP Server Wallet is unconfigured or fails on Celo
AGENT_WALLET_PRIVATE_KEY=

# x402 Protocol & Facilitator
X402_FACILITATOR_URL=https://api.x402.celo.org

# Reference Rate Providers
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
